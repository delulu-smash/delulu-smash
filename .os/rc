# Personal bashrc config (ie what run when terminal opens)
# adds to existing omarchy ~./bashrc

# TODO; add "uvx os" alias

# Configure to default open in delulu-smash repo
# NOTE: Only change directory if this is an interactive shell
# and we are currently in the home directory
if [[ $- == *i* ]] && [[ "$PWD" == "$HOME" ]]; then
    cd $HOME/repos/delulu-smash
fi

alias os='uv run $HOME/repos/delulu-smash/.os/cli.py'
