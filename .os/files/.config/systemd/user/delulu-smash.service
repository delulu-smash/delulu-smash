# AUTO-GENERATED by Claude Code
# Purpose: Keep the delulu-smash app (the services/ui Reflex app) running so the
#          SUPER+SHIFT+I web app window opens instantly. Started at login by ~/.config/hypr/autostart.lua.
# Usage: systemctl --user {start,stop,restart,status} delulu-smash   |   logs: journalctl --user -u delulu-smash -f
[Unit]
Description=delulu-smash (services/ui Reflex app on localhost:3000)
After=graphical-session.target

[Service]
Type=simple
# `ds ui run` (pkgs/ds/cli/ui.py); uv from the user manager's PATH, as there is no `ds` alias here
ExecStart=/usr/bin/env uv run --project %h/repos/delulu-smash ds ui run
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
