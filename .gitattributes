# AUTO-GENERATED by Claude Code
# this ensures parquet files - ie our smash db files - (and whenever changed)
# don't overrun github max storage
*.parquet filter=lfs diff=lfs merge=lfs -text

# sqlite db files (see spec/pkgs/ds/data/data_storage.md) - binary, so store via lfs too
*.sqlite filter=lfs diff=lfs merge=lfs -text
*.sqlite3 filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text

# web fonts the app ships (services/ui/assets/nerd_fonts/, spec/services/ui/dependencies.md): ~1 MB
# each, over the commit hook's 300 KB limit, and binary, so stored via lfs too
*.woff2 filter=lfs diff=lfs merge=lfs -text
